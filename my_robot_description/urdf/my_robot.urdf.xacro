<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="/home/fabian/ros2_ws/src/my_robot_description/urdf/lidar.urdf.xacro"/>
  <xacro:include filename="/home/fabian/ros2_ws/src/my_robot_description/urdf/imu.urdf.xacro"/>
  <xacro:include filename="/home/fabian/ros2_ws/src/my_robot_description/urdf/gps.urdf.xacro"/>

  <!-- =========================
       Properties
  ========================== -->
  <xacro:property name="base_length" value="0.6"/>
  <xacro:property name="base_width"  value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>

  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width"  value="0.05"/>

  <xacro:property name="caster_radius" value="0.05"/>

  <!-- Camera props -->
  <xacro:property name="camera_length" value="0.01"/>
  <xacro:property name="camera_width"  value="0.10"/>
  <xacro:property name="camera_height" value="0.05"/>

  <!-- =========================
       Materials (RViz)
  ========================== -->
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- =========================
       Macros
  ========================== -->
  <xacro:macro name="box_inertia" params="m l w h xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0) * (w*w + h*h)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12.0) * (l*l + h*h)}" iyz="0.0"
        izz="${(m/12.0) * (l*l + w*w)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="prefix">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="gray"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="prefix x y z">
    <joint name="base_${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- =========================
       Base
  ========================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0833" ixy="0.0" ixz="0.0"
               iyy="0.2167" iyz="0.0" izz="0.2667"/>
    </inertial>
  </link>

  <!-- Base footprint -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <xacro:wheel_link prefix="left"/>
  <xacro:wheel_link prefix="right"/>

  <!-- NOTE: z set to -0.05 as in your last version -->
  <xacro:wheel_joint prefix="left"  x="-0.15" y="0.2"  z="-0.05"/>
  <xacro:wheel_joint prefix="right" x="-0.15" y="-0.2" z="-0.05"/>

  <!-- =========================
       Caster (ball) free rotation via 2-DOF gimbal
       URDF has no true ball joint, so we approximate with 2 continuous joints.
  ========================== -->
  <link name="caster_gimbal_x_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <link name="caster_gimbal_y_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Joint 1 rotate around X at the ball center position -->
  <joint name="base_caster_gimbal_x_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_gimbal_x_link"/>
    <!-- Ball center z = -base_height/2 + caster_radius -->
    <origin xyz="0.25 0 -0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- Joint 2 rotate around Y -->
  <joint name="caster_gimbal_xy_joint" type="continuous">
    <parent link="caster_gimbal_x_link"/>
    <child link="caster_gimbal_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- The ball itself -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Mount the ball to the second gimbal link -->
  <joint name="caster_ball_mount_joint" type="fixed">
    <parent link="caster_gimbal_y_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       Camera (link + optical frame)
  ========================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>

    <xacro:box_inertia
      m="0.1"
      l="${camera_length}"
      w="${camera_width}"
      h="${camera_height}"/>
  </link>

  <joint name="base_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${(base_length + camera_length)/2.0} 0 ${base_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame for OpenCV convention -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- =========================
       Gazebo colors + friction hints
  ========================== -->
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="left_wheel_link"><material>Gazebo/Gray</material></gazebo>
  <gazebo reference="right_wheel_link"><material>Gazebo/Gray</material></gazebo>

  <gazebo reference="caster_wheel_link">
    <material>Gazebo/Gray</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="camera_link"><material>Gazebo/Red</material></gazebo>

  <!-- =========================
       Gazebo camera sensor + ROS2 camera plugin (Gazebo Classic)
  ========================== -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>
      </camera>

      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera_sensor</camera_name>
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- =========================
       Gazebo diff-drive plugin (Gazebo Classic)
  ========================== -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>

      <left_joint>base_left_wheel_joint</left_joint>
      <right_joint>base_right_wheel_joint</right_joint>

      <wheel_separation>0.45</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <command_topic>cmd_vel</command_topic>
    </plugin>
  </gazebo>

</robot>
